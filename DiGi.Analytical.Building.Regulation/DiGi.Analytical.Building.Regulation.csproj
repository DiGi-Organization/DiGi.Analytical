<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<OutputPath>..\bin\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Redirect AssemblyAttributes.cs so each project has its own -->
		<TargetFrameworkMonikerAssemblyAttributesPath>$(IntermediateOutputPath)$(MSBuildProjectName).AssemblyAttributes.cs</TargetFrameworkMonikerAssemblyAttributesPath>
		<!-- Avoid duplicate TargetFrameworkAttribute -->
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
	</PropertyGroup>
	<ItemGroup>
		<!-- Prevent duplicate 'Compile' inclusion of the generated AssemblyAttributes.cs -->
		<Compile Remove="$(IntermediateOutputPath)$(MSBuildProjectName).AssemblyAttributes.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- The serialized output of Create.ConstructionLibrary_PL(), read by Query.EmbeddedConstructionLibrary_PL(); regenerated by the ConstructionLibrary_PL_Resource fact. -->
		<EmbeddedResource Include="Resources\ConstructionLibrary_PL.json" LogicalName="DiGi.Analytical.Building.Regulation.Resources.ConstructionLibrary_PL.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
		<PackageReference Include="System.Text.Json" Version="10.0.9" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DiGi.Analytical.Building\DiGi.Analytical.Building.csproj" />
		<ProjectReference Include="..\DiGi.Analytical\DiGi.Analytical.csproj" />
		<ProjectReference Include="..\DiGi.Analytical.Building.HVAC\DiGi.Analytical.Building.HVAC.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="DiGi.Core">
			<HintPath>..\..\DiGi.Core\bin\DiGi.Core.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Core.IO">
		  <HintPath>..\..\DiGi.Core\bin\DiGi.Core.IO.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Core.Parameter">
			<HintPath>..\..\DiGi.Core\bin\DiGi.Core.Parameter.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Core.Relation">
			<HintPath>..\..\DiGi.Core\bin\DiGi.Core.Relation.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Geometry">
			<HintPath>..\..\DiGi.Geometry\bin\DiGi.Geometry.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Geometry.Object">
			<HintPath>..\..\DiGi.Geometry\bin\DiGi.Geometry.Object.dll</HintPath>
		</Reference>
	</ItemGroup>

</Project>
